{
  "name": "Musicarr Player",
  "short_name": "Musicarr",
  "description": "Listen to your Musicarr library",
  "start_url": "/player",
  "scope": "/player",
  "display": "standalone",
  "background_color": "#0f1412",
  "theme_color": "#0f1412",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
